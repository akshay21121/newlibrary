{
  "name": "single-library-management-system",
  "version": "1.0.0",
  "description": "Independent Single-Library, Single-Admin Management System",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm --prefix backend run start",
    "prisma:push": "npm --prefix backend run prisma:push",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "test": "npm --prefix backend run test",
    "backup": "node backend/scripts/backup.js",
    "restore": "node backend/scripts/restore.js"
  },
  "keywords": [
    "library-management",
    "seat-booking",
    "single-library"
  ],
  "author": "",
  "license": "ISC"
}

